# SAP Business ByDesign Tenant Configuration
SAP_TENANT_URL=https://myXXXXXX.bydesign.ondemand.com
SAP_COMMUNICATION_USER=INTEGRATION_USER
SAP_COMMUNICATION_PASSWORD=your_secure_password_here

# Service Polling & Batch Settings
POLL_INTERVAL_SECONDS=3600
BATCH_SIZE=50
RETRY_MAX_ATTEMPTS=3

# SMTP / Distribution Settings
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your_smtp_password
OUTPUT_DIRECTORY=C:\Statements\Output
